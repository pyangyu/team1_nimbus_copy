{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CiBundles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::capstone-ci-826671498662/ci/*"
    },
    {
      "Sid": "ApiKey",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1:826671498662:parameter/capstone/vllm-api-key"
    },
    {
      "Sid": "ApiKeyDecrypt",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {"StringEquals": {"kms:ViaService": "ssm.us-east-1.amazonaws.com"}}
    }
  ]
}
